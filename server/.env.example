TUNNEL_DOMAIN=tunnel.example.com
CONNECT_DOMAIN=connect.tunnel.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Published server image. Use the same release for the client and server.
TUNNEL_IMAGE=ghcr.io/ly-wo/wss-tunnel:0.2.1

# Public URL returned to the client; use http only with an HTTP public route.
TUNNEL_PUBLIC_SCHEME=https

# New source build: enable registration; set false after creating accounts if private.
TUNNEL_ALLOW_REGISTRATION=true
# Native server only (Docker uses the tunnel_data volume at /data).
# TUNNEL_DATABASE=./data/auth.sqlite3
# Shared legacy token bypasses account ownership/quota; only enable for migration.
TUNNEL_ENABLE_LEGACY_TOKEN=false

# Trust only the Traefik container IP/CIDR; empty means ignore forwarded headers.
# Example: TUNNEL_TRUSTED_PROXIES=172.20.0.2/32
TUNNEL_TRUSTED_PROXIES=
