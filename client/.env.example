TUNNEL_ENDPOINT=wss://connect.tunnel.example.com
TUNNEL_TOKEN_FILE=./secrets/token

# Server also accepts ws://, http:// (alias of ws) and https:// (alias of wss).
# Instead of a positional port, optionally configure a full local target:
# TUNNEL_TARGET=https://localhost:8443
# Custom CA for the tunnel server and local target are configured separately:
# TUNNEL_CA_CERT=./server-ca.pem
# TUNNEL_LOCAL_CA_CERT=./local-ca.pem

# Account mode takes priority over TUNNEL_TOKEN_FILE. Password is prompted securely.
# TUNNEL_USERNAME=alice
# For unattended use, optionally read the password from a protected file:
# TUNNEL_PASSWORD_FILE=./secrets/password
