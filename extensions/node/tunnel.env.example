# Copy to .env.tunnel in YOUR project's root. Paths are relative to that root.
TUNNEL_ENDPOINT=https://connect.example.com
TUNNEL_TARGET=http://127.0.0.1:3000
TUNNEL_NAME=my-app

# Tunnel server login. With username and no password file, prompt in the terminal.
TUNNEL_USERNAME=your-account
# TUNNEL_PASSWORD_FILE=.local/tunnel/server-password
# Or omit username and use TUNNEL_TOKEN_FILE=.local/tunnel/server-token

# Public-domain access authentication (separate from server login).
TUNNEL_ACCESS_BASIC_USERNAME=visitor
TUNNEL_ACCESS_BASIC_PASSWORD_FILE=.local/tunnel/access-password
# TUNNEL_ACCESS_BEARER_TOKEN_FILE=.local/tunnel/access-token

# Optional; defaults to .local/tunnel/tunnel-client, then PATH.
# TUNNEL_CLIENT_BIN=.local/tunnel/tunnel-client
# TUNNEL_CA_CERT=.local/tunnel/server-ca.pem
# TUNNEL_LOCAL_CA_CERT=.local/tunnel/local-ca.pem

# Readiness endpoint must be local, read-only, and return HTTP 2xx without auth.
TUNNEL_HEALTH_PATH=/
# Optional; required only by --start. JSON argv, never interpreted by a shell.
# TUNNEL_APP_COMMAND_JSON=["node","server.mjs"]
